# This example is installed standalone (`--ignore-workspace`) and pulls
# `lynx-fast-image` via `link:..`, so the lockfile/store state never matches
# what a plain `pnpm run dev` recomputes. Skip the pre-script deps check
# instead of letting it try to purge `node_modules` (which also fails with
# no TTY). Run `pnpm install --ignore-workspace` by hand after changing deps.
verify-deps-before-run=false
confirm-modules-purge=false
minimum-release-age=0
